# ── MeshCentral connection ───────────────────────────────────────────────
MESH_SERVER_URL=https://your-meshcentral-server.com

# Login token (preferred): create under My Account -> Login tokens. It is a
# user/password PAIR; the token username starts with "~t:". Both are required.
MESH_TOKEN_USER=~t:xxxxxxxxxxxxxxxx
MESH_TOKEN_PASS=xxxxxxxxxxxxxxxxxxxx
# Or combined: MESH_TOKEN=~t:xxxxxxxxxxxxxxxx,xxxxxxxxxxxxxxxxxxxx

# Username/password fallback (prefer a login token instead):
# MESH_USERNAME=your-username
# MESH_PASSWORD=your-password

# Skip TLS verification (self-signed certs in a lab only):
# MESH_INSECURE_TLS=false

# ── Capability policy ─────────────────────────────────────────────────────
# Which tools are exposed. Profiles: readonly (default), support, operations, admin.
#   readonly    R         inventory/monitoring only
#   support     R RF W X  adds remote read, light writes, command execution
#   operations  + WF P    adds remote file writes and disruptive/lifecycle actions
#   admin       + A       adds user/permission/server administration
MESH_MCP_PROFILE=readonly

# Fine-tune the profile (comma-separated tool names):
# MESH_MCP_ENABLE_TOOLS=mesh_run_command,mesh_terminal_open
# MESH_MCP_DISABLE_TOOLS=mesh_server_console
# Override which tiers require confirmation (default: per profile):
# MESH_MCP_CONFIRM_TIERS=X,WF,P,A

# ── Confirmation for destructive actions ──────────────────────────────────
# auto   use MCP elicitation when the client supports it, else fall back to tokens (default)
# elicit require elicitation; refuse if the client cannot elicit
# token  always use confirmation tokens
# off    no confirmation (not recommended)
MESH_MCP_CONFIRM_MODE=auto

# ── Local file access ─────────────────────────────────────────────────────
# Directory the download/upload tools are confined to (created on startup).
# Set to * to disable the jail (NOT recommended - exposes .env, keys, etc.).
MESH_LOCAL_FILE_ROOT=mcp-files

# ── Limits ────────────────────────────────────────────────────────────────
# MESH_MCP_MAX_OUTPUT=100000          # max characters per tool result
# MESH_TERMINAL_IDLE_MINUTES=15       # auto-close idle terminal sessions
# MESH_TERMINAL_MAX_SESSIONS=5        # max concurrent terminal sessions
# MESH_DESKTOP_IDLE_MINUTES=10        # auto-close idle desktop (KVM) sessions
# MESH_DESKTOP_MAX_SESSIONS=3         # max concurrent desktop sessions
# MESH_ENV_FILE=/path/to/.env         # load a specific env file
